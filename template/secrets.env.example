# Copie para secrets.env (fora do git). Lido pelo PocketBase (docker-compose env_file) e pelo worker.
LLM_KEY=
LLM_MODEL=gemini-3.5-flash-lite      # ou claude-haiku-4-5-20251001, gpt-5-mini, llama3.1…
# LLM_PROVIDER=gemini                # gemini | anthropic | openai | ollama (inferido do modelo/chave se omitido)
# LLM_BASE_URL=http://host:11434/v1  # só para OpenAI-compatível self-hosted
PB_EMAIL=admin@example.com           # superuser do PocketBase (worker e pb-setup)
PB_PASS=change-me-superuser-password
PB_USERS=atlas:12345678             # usuários da interface: nome:PIN (8 dígitos), separados por vírgula; PUBLIC_PB_USERS no .env lista os nomes
