{
  "name": "my-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-raw.mjs && vite dev",
    "build": "node scripts/sync-raw.mjs && vite build && node scripts/gen-pdf.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:llm": "ATLAS_LLM=1 playwright test tests/e2e/llm.spec.ts --project=desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "playwright-core": "^1.63.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@lucasgiraldelli/atlas-core": "github:lucas-giraldelli/atlas-core",
    "@lucide/svelte": "^1.46.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.22",
    "mermaid": "^11.15.0",
    "pocketbase": "^0.28.1"
  }
}
