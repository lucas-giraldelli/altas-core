{
  "name": "@lucasgiraldelli/atlas-core",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && svelte-package",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen-tokens": "node scripts/gen-tokens.mjs"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./styles/*": "./dist/styles/*",
    "./tokens.css": "./dist/theme/tokens.css",
    "./page-template.html": "./docs/page-template.html"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@lucide/svelte": "^1.0.0",
    "highlight.js": "^11.0.0",
    "katex": "^0.16.0",
    "mermaid": "^11.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "publint": "^0.3.21",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "@lucide/svelte": "^1.46.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.22",
    "mermaid": "^11.15.0",
    "@types/katex": "^0.16.7"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "knowledge-base",
    "didactic",
    "mermaid",
    "katex"
  ],
  "description": "Core of Atlas: renders plain didactic HTML pages into a themed static knowledge base (SvelteKit). Content loader, enhancers (Mermaid, KaTeX, highlight.js, reveal), theme tokens and UI widgets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucas-giraldelli/atlas-core.git"
  }
}
